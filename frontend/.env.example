# Copy this file to .env and replace the values for your environment.
# VITE_* variables are public in the browser bundle; never store secrets here.
VITE_API_URL=http://127.0.0.1:8000/api
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
VITE_DIRECTIONS_API_URL=https://router.project-osrm.org
VITE_GOOGLE_CLIENT_ID=your-public-google-oauth-client-id.apps.googleusercontent.com
